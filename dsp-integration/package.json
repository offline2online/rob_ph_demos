{
  "name": "ph-dsp-integration-poc",
  "private": true,
  "description": "Display Types & DSP Integration \u2014 standalone proof of concept (see docs/dsp-integration/).",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "gen:types": "npm run gen -w @ph-dsp/types",
    "dev:api": "npm run dev -w @ph-dsp/api",
    "dev:admin": "npm run dev -w @ph-dsp/admin",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "dev:mocks": "npm run dev -w @ph-dsp/dsp-mocks",
    "auction:run": "npm run auction:run -w @ph-dsp/api --"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
