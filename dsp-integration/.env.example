# Copy to .env (never committed). Read by apps/api and apps/admin.
# Feature flag `dspIntegration` — off by default.
DSP_INTEGRATION_ENABLED=false
# Stand-in HQ Admin session role (spec, Who sees each section):
# hq_admin (everything) | hq_marketing (the four shared sections, advertiser
# settings read-only) | hq_helpdesk (none of it).
POC_ROLE=hq_admin
# 32-byte key, base64, for AES-256-GCM encryption of DSP credentials at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PH_SECRETS_KEY=
# SQLite file for the API (":memory:" for an ephemeral run).
PH_DB_FILE=data/poc.sqlite
API_PORT=4000
# Partner API bearer tokens (token → partner id), JSON. Defaults when unset:
# {"poc-token-google-dv360":"p_google","poc-token-amazon-dsp":"p_amazon"}
# Those defaults are public: with NODE_ENV=production the API refuses to
# start unless this is set to tokens of your own.
PARTNER_TOKENS=

# Partner API rate limit per partner: requests per second, and the burst it
# may spend at once. Past it: 429 rate_limited with Retry-After.
# PARTNER_RATE_PER_SECOND=50
# PARTNER_RATE_BURST=100

# ---- Running on a cluster (deploy/kubernetes/README.md) ----
# Where the API listens. 127.0.0.1 (the default) is deliberate: the POC's
# Admin API has no authentication of its own. 0.0.0.0 in a container,
# behind the platform's ingress.
# API_HOST=127.0.0.1
# The scheduled work — billing, the auction at its cutoff, retention —
# runs in this process every minute (in-process, the default), or from
# outside with `npm run scheduler:tick` once a minute (off), for several
# replicas sharing one database.
# PH_SCHEDULER=in-process
# Positions the auction clears at once.
# PH_AUCTION_CONCURRENCY=16
# Asset uploads held in memory at once, across all partners (each up to the
# 200 MB asset limit): bounds the process's memory.
# PH_MAX_UPLOADS_IN_FLIGHT=4
# Rejected, lost and never-cleared bids are deleted this many days after
# their window; won and reserved windows are kept.
# PH_RESERVATION_RETENTION_DAYS=90
