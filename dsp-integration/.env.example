# Copy to .env (never committed). Read by apps/api and apps/admin.
# Feature flag `dspIntegration` — off by default.
DSP_INTEGRATION_ENABLED=false
# Feature flag `selfService` (admin UI only) — off by default. Shows the
# Available Inventory "Max campaigns" column once self-service work starts.
SELF_SERVICE_ENABLED=false
# Feature flag `changeHistory` (admin UI only) — off by default. Shows DSP
# Integration → Change history (menu row and page) once it is ready to release.
CHANGE_HISTORY_ENABLED=false
# Stand-in HQ Admin session role (spec, Who sees each section):
# hq_admin (everything) | hq_marketing (the four shared sections, advertiser
# settings read-only) | hq_helpdesk (none of it).
POC_ROLE=hq_admin
# 32-byte key, base64, for AES-256-GCM encryption of DSP credentials at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PH_SECRETS_KEY=
# SQLite file for the API (":memory:" for an ephemeral run).
PH_DB_FILE=data/poc.sqlite
# Where the migrations are, colon-separated: set by the container image and
# the hosted host for a bundled build. Unset, the source folders are used.
# PH_MIGRATIONS_DIRS=
API_PORT=4000
# Partner API bearer tokens (token → partner id), JSON. Defaults when unset:
# {"poc-token-google-dv360":"p_google","poc-token-amazon-dsp":"p_amazon"}
# Those defaults are public: with NODE_ENV=production the API refuses to
# start unless this is set to tokens of your own.
PARTNER_TOKENS=

# Partner API rate limit per partner: requests per second, and the burst it
# may spend at once. Past it: 429 rate_limited with Retry-After. A value that
# isn't a positive number falls back to the default.
# PARTNER_RATE_PER_SECOND=50
# PARTNER_RATE_BURST=100

# ---- Real-time bidding: the Player API (/api/player/v1) ----
# The bearer PH Core's player presents. Defaults to the public
# "poc-token-player" outside production; unset in production, every Player
# API call is 401.
# PH_PLAYER_TOKEN=
# The budget to clear one impression (OpenRTB tmax, 50–1000 ms), and how long
# after a fill its proof of play is accepted (seconds).
# PH_REALTIME_TMAX_MS=200
# PH_REALTIME_FILL_TTL_SEC=120

# ---- DSP endpoints (apps/api/src/config.ts) ----
# Unset, everything points at the mock DSP service (npm run dev:mocks).
# DSP_MOCKS_URL=http://127.0.0.1:4100
# Where bid requests go: mock (the *_BIDDER_URL below) or partner (each DSP's
# saved bidder endpoint, as a live exchange does).
# BID_ENDPOINT_SOURCE=mock
# DV360_BIDDER_URL= / AMAZON_BIDDER_URL= / TTD_BIDDER_URL=
# Each DSP's creative host and path: the only place a creative in a bid may
# be fetched from for review.
# DV360_CREATIVE_BASE= / AMAZON_CREATIVE_BASE= / TTD_CREATIVE_BASE=
# DSP management APIs.
# DV360_TOKEN_URL= / DV360_API_BASE_URL= / TTD_BASE_URL=
# AMAZON_ADS_BASE_URL= (or per region: AMAZON_ADS_NA_BASE_URL, _EU_, _FE_)

# Creatives (AssetStore stand-in) and this API's public origin, prefixed to
# creative URLs when the admin UI is served from elsewhere.
# PH_ASSETS_DIR=data/assets
# PH_PUBLIC_URL=

# A fresh database is seeded with the prototype's sample data (the demo
# retailer, two DSPs, campaigns, bookings; DSP integration switched on)
# except with NODE_ENV=production, where it starts empty and switched off
# unless this is set.
# PH_SEED_DEMO=true

# ---- Running on a cluster (deploy/kubernetes/README.md) ----
# Where the API listens. 127.0.0.1 (the default) is deliberate: the POC's
# Admin API has no authentication of its own. 0.0.0.0 in a container,
# behind the platform's ingress.
# API_HOST=127.0.0.1
# The scheduled work — billing, deal auctions, retention —
# runs in this process every minute (in-process, the default), or from
# outside with `npm run scheduler:tick` once a minute (off), for several
# replicas sharing one database.
# PH_SCHEDULER=in-process
# Positions the auction clears at once.
# PH_AUCTION_CONCURRENCY=16
# Asset uploads held in memory at once, across all partners (each up to the
# 200 MB asset limit): bounds the process's memory.
# PH_MAX_UPLOADS_IN_FLIGHT=4
# Rejected, lost and never-cleared bids are deleted this many days after
# their window; won and reserved windows are kept.
# PH_RESERVATION_RETENTION_DAYS=90
# Hourly unsold-slot aggregates are deleted this many days after their hour.
# PH_UNSOLD_RETENTION_DAYS=400
# Test only, refused with NODE_ENV=production: an ISO instant, or a file
# holding one, that the exchange clock reads (E2E runs).
# PH_TEST_CLOCK=
