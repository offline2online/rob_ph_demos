{
  "name": "pharmacy-screen-aws",
  "private": true,
  "description": "Pharmacy Screen Promo Template: deployment target for the retailer's AWS environment (CDK infrastructure, Lambda entries and the DynamoDB / S3 / KMS / OIDC adapters).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "deploy": "node scripts/deploy.mjs deploy",
    "destroy": "node scripts/deploy.mjs destroy",
    "plan": "node scripts/deploy.mjs deploy --dry-run",
    "synth": "node scripts/deploy.mjs synth",
    "seed": "node scripts/seed.js",
    "test": "node --test --test-concurrency=1 test/*.test.js test/*.test.mjs",
    "test:ui": "node --test --test-concurrency=1 test/ui/*.test.mjs",
    "test:dynamodb-local": "node --test --test-concurrency=1 test/dynamodb-local.integration.js"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1161.0",
    "@aws-sdk/client-kms": "3.1161.0",
    "@aws-sdk/client-s3": "3.1161.0",
    "@aws-sdk/client-secrets-manager": "3.1161.0"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "3.1161.0",
    "@aws-sdk/client-cloudwatch-logs": "3.1161.0",
    "@aws-sdk/client-cognito-identity-provider": "3.1161.0",
    "@aws-sdk/client-lambda": "3.1161.0",
    "aws-cdk": "2.1147.0",
    "aws-cdk-lib": "2.275.0",
    "constructs": "10.8.1"
  }
}
