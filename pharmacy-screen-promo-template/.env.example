# Pharmacy Screen — every function setting, placeholders only. Descriptions, types and defaults:
# docs/CONFIGURATION.md → "Environment variables".
#
# You normally set none of these by hand: `npm run deploy:aws` writes them onto the two Lambda functions
# (aws/infra/stack.js), and `npm run deploy` (Firebase) reads each function's .env.<project> file. Use this file
# only to run a function somewhere else.
#
# NEVER put the Personalisation Hub API token here, or anywhere in a file: an admin enters it in
# Admin → Settings and it is stored envelope-encrypted. No secret belongs in the front end either.

# ── Config API (Firebase function pharmacyScreenConfigApi / Lambda ConfigApi) ────────────────────────────
PS_ADMIN_CLAIM=admin
PS_ALLOWED_ORIGINS=https://<your-site>
PS_MEDIA_BUCKET=<media-bucket-name>
PS_REGION=australia-southeast1
PS_MIN_INSTANCES=0
PS_RATE_LIMIT_SCREENS_PER_IP_PER_MIN=60
PS_TRUSTED_PROXY_HOPS=1
PS_FIRESTORE_ROOT=pharmacyScreen
# AWS only (the CDK stack sets these):
PS_TABLE=<dynamodb-table-name>
PS_ROOT=pharmacyScreen
PS_MEDIA_BASE_URL=https://<your-site>
PS_ADMIN_VALUE=admin
PS_OIDC_ISSUER=https://<oidc-issuer>
PS_OIDC_AUDIENCE=<admin-editor-client-id>
PS_OIDC_JWKS_URI=https://<oidc-issuer>/.well-known/jwks.json

# ── PH API settings and Location API proxy (Firebase function pharmacyScreenPhApi / Lambda PhApi) ────────
PH_SECRET_STORE=gcp-kms
# Cloud KMS key name, or the AWS KMS key ARN on AWS. A reference, not a secret.
PH_TOKEN_KMS_KEY=projects/<project-id>/locations/global/keyRings/pharmacy-screen/cryptoKeys/ph-api-token
# Emulators and tests only (PH_SECRET_STORE=local); refused on Cloud Functions/Run and Lambda.
# PH_LOCAL_KMS_KEY=
PH_API_DEFAULT_BASE_URL=https://ph.mipharmacy.net
PH_ADMIN_CLAIM=admin
PH_ALLOWED_ORIGINS=https://<your-site>
PH_REGION=australia-southeast1
PH_MIN_INSTANCES=0
PH_SETTINGS_DOC=pharmacyScreen/private/settings/phApi
PH_AUDIT_COLLECTION=pharmacyScreen/private/auditLog
PH_PROXY_CACHE_SECONDS=15
PH_PROXY_TIMEOUT_MS=8000
PH_PROXY_STALE_SECONDS=600
PH_RATE_LIMIT_PER_DEVICE_PER_MIN=12
PH_RATE_LIMIT_PER_IP_PER_MIN=600
PH_UPSTREAM_CALLS_PER_MIN=1200
PH_RATE_LIMIT_UNKNOWN_PER_IP_PER_MIN=30
PH_TRUSTED_PROXY_HOPS=1
# AWS only (the CDK stack sets these). The CloudFront origin value is generated into Secrets Manager and read by
# reference on both functions; it is never typed and never in a function's environment:
PH_TABLE=<dynamodb-table-name>
PH_ROOT=pharmacyScreen
PS_ORIGIN_VERIFY_SECRET_ARN=<origin-verify-secret-arn>
