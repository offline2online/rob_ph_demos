{
  "hosting": [
    {
      "target": "pharmacy-screen",
      "public": ".deploy/public",
      "ignore": [
        "**/.*"
      ],
      "rewrites": [
        {
          "source": "/api/settings/ph-api",
          "function": {
            "functionId": "pharmacyScreenPhApi",
            "region": "us-central1"
          }
        },
        {
          "source": "/api/settings/ph-api/**",
          "function": {
            "functionId": "pharmacyScreenPhApi",
            "region": "us-central1"
          }
        },
        {
          "source": "/api/device/**",
          "function": {
            "functionId": "pharmacyScreenPhApi",
            "region": "us-central1"
          }
        },
        {
          "source": "/api/health",
          "function": {
            "functionId": "pharmacyScreenConfigApi",
            "region": "us-central1"
          }
        },
        {
          "source": "/api/screens/**",
          "function": {
            "functionId": "pharmacyScreenConfigApi",
            "region": "us-central1"
          }
        },
        {
          "source": "/api/admin/**",
          "function": {
            "functionId": "pharmacyScreenConfigApi",
            "region": "us-central1"
          }
        }
      ],
      "redirects": [
        {
          "source": "/",
          "destination": "/admin/",
          "type": 302
        }
      ],
      "headers": [
        {
          "source": "**/*.@(html|js|mjs|css|json)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/admin/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "Referrer-Policy",
              "value": "same-origin"
            }
          ]
        }
      ]
    }
  ],
  "functions": [
    {
      "source": "pharmacy-screen/config-api",
      "codebase": "pharmacy-screen-config-api",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "test",
        "scripts",
        "firebase.test.json",
        "*.local",
        "*-debug.log"
      ]
    },
    {
      "source": "pharmacy-screen/ph-proxy",
      "codebase": "pharmacy-screen-ph-proxy",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "test",
        ".env.example",
        "*.local",
        "*-debug.log"
      ]
    }
  ],
  "firestore": {
    "rules": ".deploy/firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": [
    {
      "target": "pharmacy-screen-media",
      "rules": "pharmacy-screen/config-api/rules/storage.rules"
    }
  ]
}
