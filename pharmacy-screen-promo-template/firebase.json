{
  "hosting": [
    {
      "target": "pharmacy-screen",
      "public": ".deploy/public",
      "ignore": [
        "**/.*"
      ],
      "rewrites": [
        {
          "source": "/api/settings/ph-api",
          "function": {
            "functionId": "pharmacyScreenPhApi",
            "region": "australia-southeast1"
          }
        },
        {
          "source": "/api/settings/ph-api/**",
          "function": {
            "functionId": "pharmacyScreenPhApi",
            "region": "australia-southeast1"
          }
        },
        {
          "source": "/api/auth/**",
          "function": {
            "functionId": "pharmacyScreenPhApi",
            "region": "australia-southeast1"
          }
        },
        {
          "source": "/api/device/**",
          "function": {
            "functionId": "pharmacyScreenPhApi",
            "region": "australia-southeast1"
          }
        },
        {
          "source": "/api/csp-report",
          "function": {
            "functionId": "pharmacyScreenConfigApi",
            "region": "australia-southeast1"
          }
        },
        {
          "source": "/api/health",
          "function": {
            "functionId": "pharmacyScreenConfigApi",
            "region": "australia-southeast1"
          }
        },
        {
          "source": "/api/screens/**",
          "function": {
            "functionId": "pharmacyScreenConfigApi",
            "region": "australia-southeast1"
          }
        },
        {
          "source": "/api/admin/**",
          "function": {
            "functionId": "pharmacyScreenConfigApi",
            "region": "australia-southeast1"
          }
        }
      ],
      "redirects": [
        {
          "source": "/",
          "destination": "/admin/",
          "type": 302
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            },
            {
              "key": "Permissions-Policy",
              "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
            }
          ]
        },
        {
          "source": "/*.@(html|js|mjs|css|json)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/@(css|js|fixtures|seed)/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "/pharmacy-screen.html",
          "headers": [
            {
              "key": "Content-Security-Policy-Report-Only",
              "value": "script-src 'self'; object-src 'none'; base-uri 'none'; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self'; report-uri /api/csp-report"
            }
          ]
        },
        {
          "source": "/admin/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "Referrer-Policy",
              "value": "same-origin"
            },
            {
              "key": "Content-Security-Policy",
              "value": "frame-ancestors 'self' https://ph.mipharmacy.net"
            },
            {
              "key": "Content-Security-Policy-Report-Only",
              "value": "script-src 'self' https://www.gstatic.com https://apis.google.com; object-src 'none'; base-uri 'none'; img-src 'self' https: data: blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://www.googleapis.com; frame-src https://rob-ph-demos.firebaseapp.com; report-uri /api/csp-report"
            }
          ]
        }
      ]
    }
  ],
  "functions": [
    {
      "source": "pharmacy-screen/config-api",
      "codebase": "pharmacy-screen-config-api",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "test",
        "scripts",
        "firebase.test.json",
        "*.local",
        "*-debug.log"
      ]
    },
    {
      "source": "pharmacy-screen/ph-proxy",
      "codebase": "pharmacy-screen-ph-proxy",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "test",
        ".env.example",
        "*.local",
        "*-debug.log"
      ]
    }
  ],
  "firestore": {
    "rules": ".deploy/firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": [
    {
      "target": "pharmacy-screen-media",
      "rules": "pharmacy-screen/config-api/rules/storage.rules"
    }
  ]
}
