# Pharmacy Screen PH API proxy — placeholders only. Never put the PH API token here:
# it is entered in the admin Settings and stored envelope-encrypted (see README.md).

# Secret store adapter: gcp-kms (default, Cloud KMS envelope encryption) or local (emulator/tests only).
PH_SECRET_STORE=gcp-kms
# Full Cloud KMS key name that wraps the token's data key (not a secret).
PH_TOKEN_KMS_KEY=projects/<project-id>/locations/global/keyRings/pharmacy-screen/cryptoKeys/ph-api-token
# Only for PH_SECRET_STORE=local: base64 of 32 random bytes. Refused when running on Cloud Functions/Run.
# PH_LOCAL_KMS_KEY=

# Base URL used until an admin saves their own list in Settings.
PH_API_DEFAULT_BASE_URL=https://ph.mipharmacy.net
# Custom claim on the Firebase ID token that marks an admin.
PH_ADMIN_CLAIM=admin
# Comma-separated origins allowed to call the settings endpoints from a browser (the admin app).
PH_ALLOWED_ORIGINS=
# Firestore locations (server-only; client rules deny them).
PH_SETTINGS_DOC=pharmacyScreen/private/settings/phApi
PH_AUDIT_COLLECTION=pharmacyScreen/private/auditLog
# Proxy tuning.
PH_PROXY_CACHE_SECONDS=15
PH_PROXY_TIMEOUT_MS=8000
PH_RATE_LIMIT_PER_DEVICE_PER_MIN=12
PH_RATE_LIMIT_PER_IP_PER_MIN=600
