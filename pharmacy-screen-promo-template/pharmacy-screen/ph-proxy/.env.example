# Pharmacy Screen PH API proxy — placeholders only. Never put the PH API token here:
# it is entered in the admin Settings and stored envelope-encrypted (see README.md).

# Secret store adapter: gcp-kms (default, Cloud KMS envelope encryption) or local (emulator/tests only).
PH_SECRET_STORE=gcp-kms
# Full Cloud KMS key name that wraps the token's data key (not a secret).
PH_TOKEN_KMS_KEY=projects/<project-id>/locations/global/keyRings/pharmacy-screen/cryptoKeys/ph-api-token
# Only for PH_SECRET_STORE=local: base64 of 32 random bytes. Emulator and tests only: the local store
# is always refused on Cloud Functions/Run (K_SERVICE set) and AWS Lambda, with no override, so a deployed
# function can only use a real KMS (Cloud KMS here; AWS KMS in the AWS deployment, aws/README.md).
# PH_LOCAL_KMS_KEY=

# Region the function is deployed to.
PH_REGION=us-central1

# Base URL used until an admin saves their own list in Settings.
PH_API_DEFAULT_BASE_URL=https://ph.mipharmacy.net
# Hosts an admin may save as a PH API base URL (the proxy sends the PH API token to them). Comma-separated;
# ".example.com" allows any host under example.com; "*" allows any https host. Default: the hosts of
# PH_API_DEFAULT_BASE_URL only.
PH_API_ALLOWED_HOSTS=
# Custom claim on the Firebase ID token that marks an admin.
PH_ADMIN_CLAIM=admin
# Comma-separated origins allowed to call the settings endpoints from a browser (the admin app).
PH_ALLOWED_ORIGINS=
# Firestore locations (server-only; client rules deny them).
PH_SETTINGS_DOC=pharmacyScreen/private/settings/phApi
PH_AUDIT_COLLECTION=pharmacyScreen/private/auditLog
# Proxy tuning.
PH_PROXY_CACHE_SECONDS=15
PH_PROXY_TIMEOUT_MS=8000
# Seconds the last good answer for a device may still be served (meta.stale) when a rate limit trips.
PH_PROXY_STALE_SECONDS=600
# Rate limits count only cache misses (calls that would reach PH), per function instance, per minute.
PH_RATE_LIMIT_PER_DEVICE_PER_MIN=12
PH_RATE_LIMIT_PER_IP_PER_MIN=600
PH_UPSTREAM_CALLS_PER_MIN=1200
# How many X-Forwarded-For entries, from the right, our own platform appends. 1 = the rightmost
# entry (the address Google's front end saw). Raise to 2 only if a real request shows the rightmost
# entry is the same proxy address for every caller. Caller-written entries to the left are ignored.
PH_TRUSTED_PROXY_HOPS=1

# Sign-in from Personalisation Hub (src/ph-session.js): the editor, embedded in HQ Admin or Retail Admin,
# exchanges the signed-in user's PH session for an editor session at POST /api/auth/ph-session.
# "off" removes the endpoint.
PH_SESSION_AUTH=on
# "true": the settings endpoints accept only sessions started from Personalisation Hub. Set it together with
# PS_REQUIRE_PH_SESSION on the config API once the deployment has no other sign-in.
PH_REQUIRE_PH_SESSION=false
# HQ Admin roles that may open the editor as an administrator (comma-separated).
PH_SESSION_HQ_ROLES=ADMIN
# The longest an editor session lasts before the editor asks Personalisation Hub for the session again.
PH_SESSION_MAX_HOURS=8
# Sign-in attempts per client address per minute, per function instance.
PH_SESSION_RATE_LIMIT_PER_IP_PER_MIN=30
