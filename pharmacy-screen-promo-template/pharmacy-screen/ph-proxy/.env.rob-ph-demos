# PH API proxy settings for our test environment (Firebase project rob-ph-demos).
# Non-secret: the Firebase CLI loads this file when deploying to rob-ph-demos.
# Never put the PH API token here: the admin enters it in Settings after deploy,
# and it is stored envelope-encrypted with the Cloud KMS key below.
PH_SECRET_STORE=gcp-kms
PH_TOKEN_KMS_KEY=projects/rob-ph-demos/locations/global/keyRings/pharmacy-screen/cryptoKeys/ph-api-token
PH_REGION=us-central1
PH_API_DEFAULT_BASE_URL=https://ph.mipharmacy.net
PH_ADMIN_CLAIM=admin
PH_ALLOWED_ORIGINS=https://rob-ph-demos-pharmacy-screen.web.app,https://rob-ph-demos-pharmacy-screen.firebaseapp.com
PH_SETTINGS_DOC=pharmacyScreen/private/settings/phApi
PH_AUDIT_COLLECTION=pharmacyScreen/private/auditLog
PH_TRUSTED_PROXY_HOPS=1
