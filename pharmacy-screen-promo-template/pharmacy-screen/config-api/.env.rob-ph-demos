# Config API settings for our test environment (Firebase project rob-ph-demos).
# Non-secret: the Firebase CLI loads this file when deploying to rob-ph-demos.
# Every setting is described in README.md → "Configuration".
PS_ADMIN_CLAIM=admin
PS_ALLOWED_ORIGINS=https://rob-ph-demos-pharmacy-screen.web.app,https://rob-ph-demos-pharmacy-screen.firebaseapp.com
PS_MEDIA_BUCKET=rob-ph-demos-pharmacy-screen-media
PS_FIRESTORE_ROOT=pharmacyScreen
PS_REGION=australia-southeast1
# true: only sessions started from Personalisation Hub (docs/PH-EMBED.md). Flip together with
# PH_REQUIRE_PH_SESSION (ph-proxy) and PS_ADMIN_AUTH=ph at deploy.
PS_REQUIRE_PH_SESSION=false
