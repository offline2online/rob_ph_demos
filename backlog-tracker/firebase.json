{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22"
    }
  ],
  "hosting": [
    {
      "public": "console-dist",
      "predeploy": [
        "node scripts/build-console.js --out console-dist"
      ],
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/help-api/**",
          "function": {
            "functionId": "helpSearch",
            "region": "us-central1"
          }
        },
        {
          "source": "/boardApi/**",
          "function": {
            "functionId": "boardApi",
            "region": "us-central1"
          }
        },
        {
          "source": "/partnerCentral/**",
          "function": {
            "functionId": "partnerCentral",
            "region": "us-central1"
          }
        },
        {
          "source": "/mediaKeys/**",
          "function": {
            "functionId": "mediaKeys",
            "region": "us-central1"
          }
        },
        {
          "source": "/supportMail/**",
          "function": {
            "functionId": "supportMail",
            "region": "us-central1"
          }
        },
        {
          "source": "/leadEnrich/**",
          "function": {
            "functionId": "leadEnrich",
            "region": "us-central1"
          }
        },
        {
          "source": "/leadIngest/**",
          "function": {
            "functionId": "leadIngest",
            "region": "us-central1"
          }
        },
        {
          "source": "/mcp",
          "function": {
            "functionId": "mcpServer",
            "region": "us-central1"
          }
        },
        {
          "source": "/mcp/**",
          "function": {
            "functionId": "mcpServer",
            "region": "us-central1"
          }
        },
        {
          "source": "/.well-known/oauth-protected-resource",
          "function": {
            "functionId": "mcpServer",
            "region": "us-central1"
          }
        },
        {
          "source": "/.well-known/oauth-protected-resource/**",
          "function": {
            "functionId": "mcpServer",
            "region": "us-central1"
          }
        },
        {
          "source": "/.well-known/oauth-authorization-server",
          "function": {
            "functionId": "mcpServer",
            "region": "us-central1"
          }
        },
        {
          "source": "/.well-known/oauth-authorization-server/**",
          "function": {
            "functionId": "mcpServer",
            "region": "us-central1"
          }
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            },
            {
              "key": "X-Frame-Options",
              "value": "SAMEORIGIN"
            },
            {
              "key": "Content-Security-Policy",
              "value": "frame-ancestors 'self'"
            },
            {
              "key": "Strict-Transport-Security",
              "value": "max-age=31536000; includeSubDomains"
            }
          ]
        },
        {
          "source": "/help-api/**",
          "headers": [
            {
              "key": "Content-Security-Policy",
              "value": "default-src 'none'"
            }
          ]
        },
        {
          "source": "/",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, must-revalidate"
            }
          ]
        },
        {
          "source": "**/",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, must-revalidate"
            }
          ]
        },
        {
          "source": "**/*.@(html|js|css)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, must-revalidate"
            }
          ]
        },
        {
          "source": "/build-info.json",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-store"
            }
          ]
        },
        {
          "source": "/js/vendor/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=604800, must-revalidate"
            }
          ]
        }
      ],
      "target": "console"
    },
    {
      "target": "help",
      "public": "help-site",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "README.md"
      ],
      "cleanUrls": false,
      "redirects": [
        {
          "source": "/console",
          "destination": "https://backlog-tracker-e4ed2.web.app/",
          "type": 302
        },
        {
          "source": "/console/**",
          "destination": "https://backlog-tracker-e4ed2.web.app/",
          "type": 302
        },
        {
          "regex": "^/support/solutions/articles/(?P<id>[0-9]+).*$",
          "destination": "https://personalisationhub.com/support-centre/support/solutions/articles/:id",
          "type": 301
        },
        {
          "source": "/article.html",
          "destination": "https://personalisationhub.com/support-centre/article.html",
          "type": 301
        },
        {
          "source": "/category.html",
          "destination": "https://personalisationhub.com/support-centre/category.html",
          "type": 301
        },
        {
          "source": "/search.html",
          "destination": "https://personalisationhub.com/support-centre/search.html",
          "type": 301
        },
        {
          "source": "/index.html",
          "destination": "https://personalisationhub.com/support-centre/",
          "type": 301
        },
        {
          "source": "/",
          "destination": "https://personalisationhub.com/support-centre/",
          "type": 301
        },
        {
          "source": "**",
          "destination": "https://personalisationhub.com/support-centre/",
          "type": 301
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            }
          ]
        },
        {
          "source": "/",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, must-revalidate"
            }
          ]
        },
        {
          "source": "**/*.@(html|json)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, must-revalidate"
            }
          ]
        },
        {
          "source": "**/*.@(js|css)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=600, must-revalidate"
            }
          ]
        }
      ]
    }
  ]
}
