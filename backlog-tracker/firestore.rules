rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // This Firestore database belongs ONLY to backlog-tracker — it runs in
    // its own Firebase project (see .firebaserc), never the "rob-ph-demos"
    // project menu-board-demo uses, so there is no shared rules file and no
    // way a change here can affect menu-board-demo's items/carts/etc rules.

    function incoming() {
      return request.resource.data;
    }

    function isNonEmptyBoundedString(v, max) {
      return v is string && v.size() > 0 && v.size() <= max;
    }

    // Prototype-stage rules: open read/write, same permissive posture the
    // rest of this repo's prototypes start with (see rob_ph_demos root
    // firestore.rules for items/carts). Tighten with Firebase Auth before
    // this is used for anything beyond an internal team tool.
    match /projects/{projectId} {
      allow read: if true;
      allow create, update: if isNonEmptyBoundedString(incoming().name, 80);
      allow delete: if true;
    }

    // Programs/Products — a purely organizational grouping above Projects
    // (see backlog-tracker/public/js/app.js groupProjectsByProgram); a
    // project's optional programId just points at a doc here, validated on
    // the projects rule above only insofar as `name` still has to be
    // present on any project write.
    match /programs/{programId} {
      allow read: if true;
      allow create, update: if isNonEmptyBoundedString(incoming().name, 80);
      allow delete: if true;
    }

    match /backlogItems/{itemId} {
      allow read: if true;

      allow create, update: if
        isNonEmptyBoundedString(incoming().projectId, 100) &&
        isNonEmptyBoundedString(incoming().title, 200) &&
        isNonEmptyBoundedString(incoming().desc, 2000) &&
        incoming().type in ["feature", "bug"] &&
        incoming().status in ["backlog", "ready-for-testing", "ready-to-publish", "published-live", "archived"];

      allow delete: if true;
    }

    // An interface is a maintained contract document shared between exactly
    // two projects (e.g. "Live Visitor Profile" <-> "Experience Templates")
    // — the backlog-tracker-native equivalent of a shared markdown file in
    // the repo, editable by whoever is driving either project's board.
    match /interfaces/{interfaceId} {
      allow read: if true;

      allow create, update: if
        isNonEmptyBoundedString(incoming().name, 120) &&
        incoming().projectIds is list &&
        incoming().projectIds.size() == 2 &&
        isNonEmptyBoundedString(incoming().projectIds[0], 100) &&
        isNonEmptyBoundedString(incoming().projectIds[1], 100) &&
        incoming().contentMd is string &&
        incoming().contentMd.size() <= 20000;

      allow delete: if true;
    }

    // A project doc is a generic, named document belonging to exactly one
    // project (an API spec, an architecture decision record, anything that
    // isn't Requirements or the README fields on projects/{projectId}
    // itself) — the "Additional documents" list on that project's Docs
    // page. Unlike an interface, never shared between two projects.
    match /projectDocs/{docId} {
      allow read: if true;

      allow create, update: if
        isNonEmptyBoundedString(incoming().projectId, 100) &&
        isNonEmptyBoundedString(incoming().name, 120) &&
        incoming().contentMd is string &&
        incoming().contentMd.size() <= 20000;

      allow delete: if true;
    }

    // ── FAQ / Help Center content ─────────────────────────────────────────
    // These two collections feed the PUBLIC help centre (repo-root faq/,
    // iframed into personalisationhub.com), so unlike the rest of this
    // prototype's collections they are NOT open for writing. Reads stay
    // public (the site and its freshness check read them anonymously);
    // every create/update/delete requires a signed-in Google account whose
    // verified email is on the editor allowlist below — the "Sign in to
    // edit" button on the FAQ pages of the admin console. The deploy
    // workflow's sync/export scripts use the Admin SDK and bypass rules.
    function isFaqEditor() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          "rob@offline2online.com",
          "rob@personalisationhub.com"
        ];
    }

    match /faqCategories/{categoryId} {
      allow read: if true;
      allow create, update: if isFaqEditor()
        && isNonEmptyBoundedString(incoming().name, 80)
        && isNonEmptyBoundedString(incoming().icon, 40)
        && incoming().order is number
        && (!("description" in incoming()) || incoming().description is string && incoming().description.size() <= 300)
        && (!("parentId" in incoming()) || incoming().parentId == null || isNonEmptyBoundedString(incoming().parentId, 100));
      allow delete: if isFaqEditor();
    }

    match /faqArticles/{articleId} {
      allow read: if true;
      allow create, update: if isFaqEditor()
        && incoming().size() <= 40
        && isNonEmptyBoundedString(incoming().categoryId, 100)
        && isNonEmptyBoundedString(incoming().title, 200)
        && isNonEmptyBoundedString(incoming().slug, 200)
        && incoming().bodyMd is string && incoming().bodyMd.size() <= 60000
        && (!("summary" in incoming()) || incoming().summary is string && incoming().summary.size() <= 400)
        && (!("keywords" in incoming()) || incoming().keywords is list && incoming().keywords.size() <= 30)
        && (!("docType" in incoming()) || incoming().docType in ["faq", "how-to", "reference", "explanation"])
        && incoming().status in ["draft", "published"]
        && incoming().order is number;
      allow delete: if isFaqEditor();
    }
  }
}
