rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // This Firestore database belongs ONLY to backlog-tracker — it runs in
    // its own Firebase project (see .firebaserc), never the "rob-ph-demos"
    // project menu-board-demo uses, so there is no shared rules file and no
    // way a change here can affect menu-board-demo's items/carts/etc rules.

    function incoming() {
      return request.resource.data;
    }

    function isNonEmptyBoundedString(v, max) {
      return v is string && v.size() > 0 && v.size() <= max;
    }

    // ── Who may use the board ──────────────────────────────────────────────
    // The whole console is behind Google sign-in: every read and write of the
    // board's collections requires a signed-in account whose verified email
    // is on this allowlist (mirrored in public/js/auth-gate.js — keep the two
    // in sync). Server-side jobs (Cloud Functions, the deploy workflow's
    // scripts, the backlog automation) use a service account and bypass
    // rules. The only anonymous access left is READ of the two help-centre
    // collections, which feed the public FAQ site.
    function isEditor() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          "rob@offline2online.com",
          "rob@personalisationhub.com",
          "board-automation@backlog-tracker-e4ed2.firebaseapp.com"
        ];
    }

    // ── Deployment train state on a project ────────────────────────────────
    // A project's tickets all build onto one integration branch
    // (deployBranch) and ship as one PR — see backlog-tracker/README.md →
    // "The deployment train". These fields decide which branch a real merge
    // points at, so a person clicking around the board must not be able to
    // move them.
    //
    // "Automation" here is TWO different principals, and conflating them is
    // what broke the Deploy flow on its first real use:
    //
    //   * run-backlog-automation.js writes deployBranch/trainStatus/
    //     trainPrNumber/trainNote as the Firebase SERVICE ACCOUNT, which
    //     bypasses these rules entirely. Nothing here applies to it.
    //   * the Notify Claude Routine writes trainReady — the single signal
    //     that starts a deploy — as the board automation USER
    //     (board-automation@…, Identity Toolkit, see ROUTINE_INSTRUCTIONS.md
    //     "Board access"). That is an ordinary signed-in account and these
    //     rules DO apply to it.
    //
    // Guarding every train field as "unchanged unless you bypass rules"
    // therefore denied the Routine's own trainReady write. The Deploy to
    // Main button fired the Routine, the Routine got PERMISSION_DENIED,
    // nothing set trainReady, no automation run was dispatched, and the card
    // sat in Approved for Deployment while the button spun and reverted —
    // reported as "it just keeps going back to the ready for deployment
    // column". So the automation user is let through; only the two human
    // editor accounts are held to the unchanged-fields guard.
    //
    // This does not widen what a prompt-injected Routine session could do:
    // that session can already set patchReady with arbitrary patchFiles,
    // which puts arbitrary code on the branch in the first place. trainReady
    // only merges what is already there, after the board's own approval gate.
    function isBoardAutomation() {
      return request.auth != null
        && request.auth.token.email == "board-automation@backlog-tracker-e4ed2.firebaseapp.com";
    }
    function trainFieldUnchanged(f) {
      return (f in incoming()) == (f in resource.data)
        && (!(f in incoming()) || incoming()[f] == resource.data[f]);
    }
    function trainFieldsAreAutomationOnly() {
      return trainFieldUnchanged("deployBranch")
        && trainFieldUnchanged("trainReady")
        && trainFieldUnchanged("trainStatus")
        && trainFieldUnchanged("trainPrNumber")
        && trainFieldUnchanged("trainNote")
        && trainFieldUnchanged("needsHumanMerge");
    }
    // trainLocked is the one exception, and only in one direction: the
    // board latches it true the moment a project's first ticket is approved
    // (app.js's deployToFeature), which is what stops a new ticket joining a
    // release that is already closing. CLEARING it is what lets builds start
    // again, and only a merged train may do that — so the browser can set it
    // and never unset it.
    function trainLockOnlyLatches() {
      return !("trainLocked" in incoming())
        || incoming().trainLocked == true
        || trainFieldUnchanged("trainLocked");
    }

    match /projects/{projectId} {
      allow read: if isEditor();
      allow create: if isEditor() && isNonEmptyBoundedString(incoming().name, 80)
        && (isBoardAutomation() || (
          !("deployBranch" in incoming()) && !("trainReady" in incoming())
          && !("trainStatus" in incoming()) && !("trainPrNumber" in incoming())
          && !("trainNote" in incoming()) && !("needsHumanMerge" in incoming())
          && !("trainLocked" in incoming())));
      allow update: if isEditor() && isNonEmptyBoundedString(incoming().name, 80)
        && (isBoardAutomation() || (trainFieldsAreAutomationOnly() && trainLockOnlyLatches()));
      allow delete: if isEditor();
    }

    // Programs/Products — a purely organizational grouping above Projects
    // (see backlog-tracker/public/js/app.js groupProjectsByProgram); a
    // project's optional programId just points at a doc here, validated on
    // the projects rule above only insofar as `name` still has to be
    // present on any project write.
    match /programs/{programId} {
      allow read: if isEditor();
      allow create, update: if isEditor() && isNonEmptyBoundedString(incoming().name, 80);
      allow delete: if isEditor();
    }

    match /backlogItems/{itemId} {
      allow read: if isEditor();

      allow create, update: if isEditor() &&
        isNonEmptyBoundedString(incoming().projectId, 100) &&
        isNonEmptyBoundedString(incoming().title, 200) &&
        isNonEmptyBoundedString(incoming().desc, 2000) &&
        incoming().type in ["feature", "bug"] &&
        incoming().status in ["backlog", "ready-for-testing", "ready-to-publish", "published-live", "archived"];

      allow delete: if isEditor();
    }

    // An interface is a maintained contract document shared between exactly
    // two projects (e.g. "Live Visitor Profile" <-> "Experience Templates")
    // — the backlog-tracker-native equivalent of a shared markdown file in
    // the repo, editable by whoever is driving either project's board.
    match /interfaces/{interfaceId} {
      allow read: if isEditor();

      allow create, update: if isEditor() &&
        isNonEmptyBoundedString(incoming().name, 120) &&
        incoming().projectIds is list &&
        incoming().projectIds.size() == 2 &&
        isNonEmptyBoundedString(incoming().projectIds[0], 100) &&
        isNonEmptyBoundedString(incoming().projectIds[1], 100) &&
        incoming().contentMd is string &&
        incoming().contentMd.size() <= 20000;

      allow delete: if isEditor();
    }

    // A project doc is a generic, named document belonging to exactly one
    // project (an API spec, an architecture decision record, anything that
    // isn't Requirements or the README fields on projects/{projectId}
    // itself) — the "Additional documents" list on that project's Docs
    // page. Unlike an interface, never shared between two projects.
    match /projectDocs/{docId} {
      allow read: if isEditor();

      allow create, update: if isEditor() &&
        isNonEmptyBoundedString(incoming().projectId, 100) &&
        isNonEmptyBoundedString(incoming().name, 120) &&
        incoming().contentMd is string &&
        incoming().contentMd.size() <= 20000;

      allow delete: if isEditor();
    }

    // ── FAQ / Help Center content ─────────────────────────────────────────
    // These two collections feed the PUBLIC help centre (repo-root faq/,
    // iframed into personalisationhub.com). Reads stay public — the site
    // and its per-article freshness check read them anonymously — and
    // writes require the same signed-in editor as the rest of the board.
    function isFaqEditor() { return isEditor(); }

    match /faqCategories/{categoryId} {
      allow read: if true;
      allow create, update: if isFaqEditor()
        && isNonEmptyBoundedString(incoming().name, 80)
        && isNonEmptyBoundedString(incoming().icon, 40)
        && incoming().order is number
        && (!("description" in incoming()) || incoming().description is string && incoming().description.size() <= 300)
        && (!("parentId" in incoming()) || incoming().parentId == null || isNonEmptyBoundedString(incoming().parentId, 100));
      allow delete: if isFaqEditor();
    }

    // ── Pipeline health strip (YeCj7sNpHXFUZQhmAmEb) ───────────────────────
    // A single doc each workflow (backlog-automation.yml,
    // deploy-backlog-tracker.yml) overwrites at the end of its own run, via
    // the same service-account credential those workflows already use for
    // every other Firestore write in this file's collections — that
    // credential authenticates as a GCP IAM principal, not a signed-in
    // Firebase Auth user, so it bypasses these rules entirely the same way
    // every other write from run-backlog-automation.js already does.
    // Nothing in the browser is ever meant to write this, only read it.
    match /systemStatus/{docId} {
      allow read: if isEditor();
    }

    // A proposed revision parked on an article by the Deploy-flow Routine
    // (see ROUTINE_INSTRUCTIONS.md → "FAQ impact review") or edited from the
    // console's review view. It never changes the live fields by itself —
    // functions/index.js promotes it once approved AND its source tickets
    // are published-live. Only the shape is validated here; the content is
    // sanitised at render time like bodyMd.
    function isValidPendingRevision(r) {
      return r is map
        && isNonEmptyBoundedString(r.title, 200)
        && r.bodyMd is string && r.bodyMd.size() <= 60000
        && (!("summary" in r) || r.summary is string && r.summary.size() <= 400)
        && (!("keywords" in r) || r.keywords is list && r.keywords.size() <= 30)
        && (!("docType" in r) || r.docType in ["faq", "how-to", "reference", "explanation"])
        && (!("reason" in r) || r.reason is string && r.reason.size() <= 2000)
        && r.sourceItemIds is list && r.sourceItemIds.size() > 0 && r.sourceItemIds.size() <= 50
        && r.reviewStatus in ["awaiting-review", "approved"];
    }
    // The text a promotion replaced, kept so a reviewer can revert.
    function isValidPreviousRevision(r) {
      return r is map
        && r.title is string && r.title.size() <= 200
        && r.bodyMd is string && r.bodyMd.size() <= 60000
        && (!("summary" in r) || r.summary is string && r.summary.size() <= 400);
    }

    match /faqArticles/{articleId} {
      allow read: if true;
      allow create, update: if isFaqEditor()
        && incoming().size() <= 40
        && (!("pendingRevision" in incoming()) || incoming().pendingRevision == null || isValidPendingRevision(incoming().pendingRevision))
        && (!("previousRevision" in incoming()) || incoming().previousRevision == null || isValidPreviousRevision(incoming().previousRevision))
        && isNonEmptyBoundedString(incoming().categoryId, 100)
        && isNonEmptyBoundedString(incoming().title, 200)
        && isNonEmptyBoundedString(incoming().slug, 200)
        && incoming().bodyMd is string && incoming().bodyMd.size() <= 60000
        && (!("summary" in incoming()) || incoming().summary is string && incoming().summary.size() <= 400)
        && (!("keywords" in incoming()) || incoming().keywords is list && incoming().keywords.size() <= 30)
        && (!("docType" in incoming()) || incoming().docType in ["faq", "how-to", "reference", "explanation"])
        && incoming().status in ["draft", "published"]
        && incoming().order is number;
      allow delete: if isFaqEditor();
    }

    // Site-wide settings for the public FAQ / Help Center (kup9Zce13jyaXcIhxVkf)
    // — currently just the analytics tag id appended to every customer-facing
    // FAQ page (see faq/js/page-common.js). Read/write here is editor-only,
    // from the console's Settings page; faq-export.js reads this doc as the
    // service account (bypasses these rules, same as every other export
    // step) and republishes it as a public static file
    // (faq/data/settings.json) — the public site itself never talks to
    // Firestore for this.
    match /settings/{docId} {
      allow read: if isEditor();
      allow create, update: if isEditor()
        && (!("analyticsTag" in incoming()) || incoming().analyticsTag == null
          || (incoming().analyticsTag is string && incoming().analyticsTag.size() <= 40));
      allow delete: if isEditor();
    }
  }
}
