# Copy to media-studio/.env (gitignored) and fill in. NEVER commit real keys:
# this repository is public.

# Google AI Studio key (aistudio.google.com/apikey). Used for Nano Banana Pro
# images AND Veo 3.1 video — one key covers both.
GEMINI_API_KEY=

# LTX key (console.ltx.io → API keys). Used for LTX 2.5 video.
LTX_API_KEY=

# Optional: push finished assets straight into a WordPress media library.
# WP_AUTH is "<wp-username>:<application-password>" (or its base64).
# WP_SITE_URL=https://personalisationhub.com
# WP_AUTH=

# Optional overrides — the defaults are the current model ids.
# NANO_BANANA_MODEL=gemini-3-pro-image-preview
# VEO_MODEL=veo-3.1-generate-preview
# VEO_FAST_MODEL=veo-3.1-fast-generate-preview
# LTX_MODEL=ltx-2-5-pro
# LTX_FAST_MODEL=ltx-2-5-fast
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# LTX_BASE_URL=https://api.ltx.io

# Server. Binds to localhost only unless MEDIA_STUDIO_TOKEN is set, in which
# case every /v1 call needs "Authorization: Bearer <token>".
# PORT=8787
# HOST=127.0.0.1
# MEDIA_STUDIO_TOKEN=
# MEDIA_STUDIO_OUTPUT=./output
