{
  "name": "media-studio",
  "version": "1.0.0",
  "private": true,
  "description": "One API for website and blog imagery and video: Nano Banana Pro (Gemini), Veo 3.1 and LTX 2.5.",
  "type": "commonjs",
  "engines": { "node": ">=20" },
  "bin": { "media-studio": "src/cli.js" },
  "scripts": {
    "start": "node src/cli.js serve",
    "image": "node src/cli.js image",
    "video": "node src/cli.js video",
    "list": "node src/cli.js list",
    "check": "node src/cli.js check",
    "test": "node --test test/*.test.js"
  }
}
